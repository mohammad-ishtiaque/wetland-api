# ─────────────────────────────────────────────────────────────────
# Clima Norm / Site Norm API — environment configuration
#
# This file lists every environment variable the code actually reads
# (verified against `grep -r "process.env" src/`, not just copied from
# an old template). If you add a new process.env.X reference in code,
# add it here too — a stale template is worse than no template.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=5000
# Used as the listen hostname for app.listen(PORT, BASE_URL) in server.js —
# despite the name, this must be a bindable host/IP (e.g. "localhost" or
# "0.0.0.0"), NOT a full URL like "https://api.example.com". Leave unset to
# default to localhost. If your production host expects app.listen to bind
# 0.0.0.0 (most container platforms do), set BASE_URL=0.0.0.0 explicitly.
BASE_URL=localhost

# MongoDB
MONGO_URL=mongodb://localhost:27017/agroclima

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=365d

# Email (for OTP + password reset) — sent via Nodemailer's named-service
# transport (e.g. "gmail"), not raw SMTP host/port.
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SERVICE_NAME=Site Norm
EMAIL_FROM=your_email@gmail.com

# RevenueCat webhook — set this to match the "Authorization" header value
# you configure in RevenueCat Dashboard > Project Settings > Integrations >
# Webhooks. Leave unset during local testing; the webhook will still accept
# events (unauthenticated) but MUST be set before going live.
REVENUECAT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────
# NOT environment-configurable, listed here so you don't go looking:
# third-party API base URLs (ACIS, SDA, FCC geocoder) and NRCS procedure
# constants (WETS_YEAR_START/END, MAX_STATION_DISTANCE_MILES) are hardcoded
# in src/config/constants.js, explicitly commented "NEVER CHANGE" — they
# are fixed by the NRCS Procedure 2 specification, not deployment config.
# ─────────────────────────────────────────────────────────────────
